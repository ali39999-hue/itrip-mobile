{
  "expo": {
    "name": "iTrip",
    "slug": "itrip-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "itrip",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#00A9A5"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.firuzo.itrip"
    },
    "android": {
      "package": "com.firuzo.itrip",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#00A9A5"
      },
      "permissions": [
        "INTERNET",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        { "faceIDPermission": "Allow iTrip to unlock your travel vault with biometrics" }
      ],
      "expo-local-authentication",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
