<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
  <!-- Security (OWASP MASVS): Exclude Android Keystore SharedPreferences and SQLCipher database from cloud backups -->
  <exclude domain="sharedpref" path="SecureStore" />
  <exclude domain="sharedpref" path="itrip.accessToken" />
  <exclude domain="sharedpref" path="itrip.refreshToken" />
  <exclude domain="database" path="itrip-vault.db" />
</full-backup-content>
